# SQLite（本地默认）。换 Postgres：postgresql://USER:PASS@localhost:5432/crazywords
DATABASE_URL="file:./dev.db"

# 可选访问门禁（设置后需在页面输入密码；发布场景建议设置）
APP_ACCESS_PASSWORD=""

# ASR / TTS：mock（本地开发默认）| aliyun（真实 HTTP，需密钥；失败不会回退 mock）
SPEECH_PROVIDER="mock"

# 阿里云智能语音交互 · 地域（默认上海）
NLS_REGION="cn-shanghai"

# —— 一句话识别（ASR）——
# 控制台：https://nls-portal.console.aliyun.com/
# 使用与项目相同账号的 AccessKey；AppKey 来自「全部项目」里创建的项目
ASR_ACCESS_KEY_ID=""
ASR_ACCESS_KEY_SECRET=""
ASR_APP_KEY=""

# —— 语音合成（TTS）——
# 可与 ASR 使用同一 AccessKey / 同一项目 AppKey，也可分开填
TTS_ACCESS_KEY_ID=""
TTS_ACCESS_KEY_SECRET=""
TTS_APP_KEY=""
# 可选：发音人（中文默认 xiaoyun；英文可试 betty 等，以控制台可用音色为准）
TTS_VOICE="xiaoyun"
TTS_FORMAT="mp3"
TTS_SAMPLE_RATE="16000"

# 上传上限（字节）
MAX_AUDIO_BYTES="2097152"
MAX_CSV_BYTES="1048576"

# —— 词典自动补全（手工导入）——
# freedict | datamuse | auto（先 Free Dictionary，失败回退 Datamuse）
DICTIONARY_PROVIDER="auto"
DICTIONARY_API_BASE="https://api.dictionaryapi.dev/api/v2/entries/en"
# 中文释义：mymemory | none
TRANSLATE_PROVIDER="mymemory"
# 可选：提高 MyMemory 额度
MYMEMORY_EMAIL=""
