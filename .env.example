# SQLite（本地默认）。换 Postgres：postgresql://USER:PASS@localhost:5432/crazywords
DATABASE_URL="file:./dev.db"

# 可选访问门禁（设置后需在页面输入密码；发布场景建议设置）
APP_ACCESS_PASSWORD=""

# =============================================================================
# 语音（听写实时 ASR + TTS 播报）
# mock = 仅本地开发模拟；aliyun = 必须真实调用，缺密钥会报错，绝不静默回退 mock
# =============================================================================
SPEECH_PROVIDER="mock"

# 阿里云智能语音交互地域（默认上海）
NLS_REGION="cn-shanghai"
# 实时语音识别 WebSocket（一般无需改）
NLS_WS_URL="wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1"

# —— 实时语音识别 / 一句话 ASR（听写主路径：浏览器 SpeechTranscriber）——
# 控制台：https://nls-portal.console.aliyun.com/
# 项目须开通「实时语音识别」；模式 A 建议英文模型，模式 B 需中文识别能力
# 注意：语种模型在控制台「项目」里选择，WebSocket 协议没有 model 参数；
# 前端 targetText 只是 mock/纠错提示，不会当热词上传，热词只能用下面的 console 热词 ID
ASR_ACCESS_KEY_ID=""
ASR_ACCESS_KEY_SECRET=""
ASR_APP_KEY=""
# 采集/发送采样率：NLS 只支持 8000 | 16000（PCM 16bit 单声道）。默认 16000，
# 浏览器 AudioContext 若跑在 44.1k/48k，前端会自动重采样到该值（无需手改）。
NLS_ASR_SAMPLE_RATE="16000"
# 断句静音阈值 200~2000ms（默认 800）；单字/单词听写可调到 500~600 让结果更快落定
NLS_ASR_MAX_SENTENCE_SILENCE="800"
# 是否让识别结果带标点（听写比对建议 false）
NLS_ASR_PUNCTUATION="false"
NLS_ASR_INTERMEDIATE_RESULT="true"
# 可选：控制台创建「定制泛热词」/「自学习模型」后填 ID，可显著提升专有词命中率
NLS_ASR_VOCABULARY_ID=""
NLS_ASR_CUSTOMIZATION_ID=""
# 一句话识别 REST 超时（ms）
ASR_TIMEOUT_MS="30000"

# —— 语音合成 TTS（听写播报中文释义 / 英文单词，禁止生产用浏览器 SpeechSynthesis）——
# 项目须开通「语音合成」。可与 ASR 使用同一 AccessKey / AppKey（若 TTS_* 留空会回退读 ASR_*）
TTS_ACCESS_KEY_ID=""
TTS_ACCESS_KEY_SECRET=""
TTS_APP_KEY=""
# 中文发音人（默认 xiaoyun）
TTS_VOICE="xiaoyun"
# 英文发音人：ava（美式英文女声，8K/16K，默认）| betty / donna / cindy | brian / david（男声）
TTS_VOICE_EN="ava"
TTS_FORMAT="mp3"
# 采样率：短文本 TTS 的 ava/betty 仅支持 8K/16K，故默认 16000 最稳；
# 24K 仅部分发音人支持（如 david、abby_ecmix），换成不支持 24K 的发音人会报 41020001
TTS_SAMPLE_RATE="16000"
# 语速 -500~500：0=原速；官方公式 (1-1/倍数)/0.002，故 -125≈0.8 倍速、-100≈0.83 倍速。
# 英文单词拼写默认稍慢更清晰；中文维持原速
TTS_SPEECH_RATE_ZH="0"
TTS_SPEECH_RATE_EN="-100"
# 音调 -500~500（默认 0）与音量 0~100（默认 50）
TTS_PITCH_RATE="0"
TTS_VOLUME="50"
# TTS REST 超时（ms）
TTS_TIMEOUT_MS="15000"

# 上传上限（字节）
MAX_AUDIO_BYTES="2097152"
MAX_CSV_BYTES="1048576"

# —— 词典自动补全（手工导入）——
DICTIONARY_PROVIDER="auto"
DICTIONARY_API_BASE="https://api.dictionaryapi.dev/api/v2/entries/en"
TRANSLATE_PROVIDER="mymemory"
MYMEMORY_EMAIL=""
