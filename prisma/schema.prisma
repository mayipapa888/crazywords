// CrazyWords MVP data model (SQLite for local; swap DATABASE_URL for Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(cuid())
  sessionKey             String?  @unique // httpOnly cookie 绑定的会话用户
  locale                 String   @default("zh-CN")
  dailyGoalDefault       Int      @default(20)
  /// 沿用字段名：启用听写模式 B（报单词 → 说中文）；关闭则仅模式 A
  clozeEnabled           Boolean  @default(true)
  /// 听写：录音开始后自动提交秒数
  autoSubmitSeconds      Int      @default(15)
  /// 听写：进入题目后自动开始录音秒数
  autoStartRecordSeconds Int      @default(10)
  /// 听写：反馈后自动下一词秒数
  autoNextWordSeconds    Int      @default(30)
  createdAt              DateTime @default(now())

  wordLists      WordList[]
  cardStates     CardState[]
  wrongBookItems WrongBookItem[]
  sessions       Session[]
  notes          KnowledgeNote[]
  listeningLogs  ListeningLog[]
  pet            Pet?
  battleRecords  BattleRecord[]
  pointSpends    PointSpend[]
}

model WordList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  source    String   @default("import") // import | manual
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WordEntry[]

  @@index([userId])
}

model WordEntry {
  id        String   @id @default(cuid())
  listId    String
  word      String
  glossZh   String?
  ipa       String?
  pos       String?
  example   String?
  phrases   String   @default("[]") // JSON array
  related   String   @default("[]") // JSON array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list           WordList        @relation(fields: [listId], references: [id], onDelete: Cascade)
  cardStates     CardState[]
  wrongBookItems WrongBookItem[]
  attempts       Attempt[]

  @@unique([listId, word])
  @@index([listId])
}

model CardState {
  id         String    @id @default(cuid())
  userId     String
  entryId    String
  status     String    @default("new") // new | learning | review | relearning | suspended
  easeFactor Float     @default(2.5)
  intervalDays Int     @default(0)
  dueAt      DateTime?
  reps       Int       @default(0)
  lapses     Int       @default(0)
  lastResult String? // again | hard | good | easy
  updatedAt  DateTime  @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry WordEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId, dueAt])
  @@index([userId, status])
}

model WrongBookItem {
  id             String   @id @default(cuid())
  userId         String
  entryId        String
  wrongCount     Int      @default(1)
  lastWrongAt    DateTime @default(now())
  lastWrongKinds String   @default("both") // spelling | pronunciation | both
  active         Boolean  @default(true)
  consecutiveOk  Int      @default(0)

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry WordEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId, active])
}

model Session {
  id                   String    @id @default(cuid())
  userId               String
  date                 String // YYYY-MM-DD local
  goalN                Int
  queueSnapshot        String    @default("[]") // JSON entry ids
  clozeEnabledSnapshot Boolean   @default(true)
  startedAt            DateTime  @default(now())
  endedAt              DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([userId, date])
}

model Attempt {
  id              String   @id @default(cuid())
  sessionId       String
  entryId         String
  mode            String // gloss | meaning（旧 cloze 兼容读作 meaning）
  spellingInput   String
  spellingOk      Boolean
  asrTranscript   String?
  pronunciationOk Boolean
  overallOk       Boolean
  createdAt       DateTime @default(now())

  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entry   WordEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([entryId])
}

/// 磨耳朵收听时长：按用户 + 自然日累加，date 为 YYYY-MM-DD（Asia/Shanghai 本地日）
model ListeningLog {
  id        String   @id @default(cuid())
  userId    String
  date      String
  seconds   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model KnowledgeNote {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String // 多行纯文本，词语辨析或语法笔记（列表摘要 / 搜索用）
  /// 富文本 HTML；为空时回退到 content 纯文本
  contentHtml String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 宠物养成：exp 为累计经验，stage 1..5；GET /api/pet 时惰性结算当日经验
model Pet {
  id               String   @id @default(cuid())
  userId           String   @unique
  name             String   @default("小星")
  stage            Int      @default(1) // 1..5
  exp              Int      @default(0) // 累计经验
  tickets          Int      @default(0) // 吃鸡券
  /// 已按「每 100 EXP」发放过的券数；只增不减，用于幂等补发
  milestoneIssued  Int      @default(0)
  /// 当天已喂食次数（每天按 Asia/Shanghai 重置）
  feedCountToday   Int      @default(0)
  /// feedCountToday 所属日期 YYYY-MM-DD
  feedDate         String   @default("")
  lastExpDate      String   @default("") // 最近一次结算经验的 YYYY-MM-DD（Asia/Shanghai）
  dailyExpJson     String   @default("{}") // 当天各来源已获得的 EXP，如 {"dictation":12,"listening":3,...}
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 吃鸡战绩：enter 时创建（playing），finish 时结算经验（finished）
model BattleRecord {
  id         String    @id @default(cuid())
  userId     String
  status     String    @default("playing") // playing | finished
  kills      Int       @default(0)
  placement  Int       @default(0) // 1 = 吃鸡
  seconds    Int       @default(0)
  expGained  Int       @default(0)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// 积分消耗流水：喂食等消耗，可用积分 = 累计积分 − SUM(amount)
model PointSpend {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
