// CrazyWords MVP data model (SQLite for local; swap DATABASE_URL for Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(cuid())
  sessionKey             String?  @unique // httpOnly cookie 绑定的会话用户
  locale                 String   @default("zh-CN")
  dailyGoalDefault       Int      @default(20)
  /// 沿用字段名：启用听写模式 B（报单词 → 说中文）；关闭则仅模式 A
  clozeEnabled           Boolean  @default(true)
  /// 听写：录音开始后自动提交秒数
  autoSubmitSeconds      Int      @default(15)
  /// 听写：进入题目后自动开始录音秒数
  autoStartRecordSeconds Int      @default(10)
  /// 听写：反馈后自动下一词秒数
  autoNextWordSeconds    Int      @default(30)
  createdAt              DateTime @default(now())

  wordLists      WordList[]
  cardStates     CardState[]
  wrongBookItems WrongBookItem[]
  sessions       Session[]
  notes          KnowledgeNote[]
}

model WordList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  source    String   @default("import") // import | manual
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WordEntry[]

  @@index([userId])
}

model WordEntry {
  id        String   @id @default(cuid())
  listId    String
  word      String
  glossZh   String?
  ipa       String?
  pos       String?
  example   String?
  phrases   String   @default("[]") // JSON array
  related   String   @default("[]") // JSON array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list           WordList        @relation(fields: [listId], references: [id], onDelete: Cascade)
  cardStates     CardState[]
  wrongBookItems WrongBookItem[]
  attempts       Attempt[]

  @@unique([listId, word])
  @@index([listId])
}

model CardState {
  id         String    @id @default(cuid())
  userId     String
  entryId    String
  status     String    @default("new") // new | learning | review | relearning | suspended
  easeFactor Float     @default(2.5)
  intervalDays Int     @default(0)
  dueAt      DateTime?
  reps       Int       @default(0)
  lapses     Int       @default(0)
  lastResult String? // again | hard | good | easy
  updatedAt  DateTime  @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry WordEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId, dueAt])
  @@index([userId, status])
}

model WrongBookItem {
  id             String   @id @default(cuid())
  userId         String
  entryId        String
  wrongCount     Int      @default(1)
  lastWrongAt    DateTime @default(now())
  lastWrongKinds String   @default("both") // spelling | pronunciation | both
  active         Boolean  @default(true)
  consecutiveOk  Int      @default(0)

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry WordEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId, active])
}

model Session {
  id                   String    @id @default(cuid())
  userId               String
  date                 String // YYYY-MM-DD local
  goalN                Int
  queueSnapshot        String    @default("[]") // JSON entry ids
  clozeEnabledSnapshot Boolean   @default(true)
  startedAt            DateTime  @default(now())
  endedAt              DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([userId, date])
}

model Attempt {
  id              String   @id @default(cuid())
  sessionId       String
  entryId         String
  mode            String // gloss | meaning（旧 cloze 兼容读作 meaning）
  spellingInput   String
  spellingOk      Boolean
  asrTranscript   String?
  pronunciationOk Boolean
  overallOk       Boolean
  createdAt       DateTime @default(now())

  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entry   WordEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([entryId])
}

model KnowledgeNote {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String // 多行文本，词语辨析或语法笔记
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
